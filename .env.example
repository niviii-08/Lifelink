# Copy this file to .env and fill in real values. Never commit the actual .env file.

# Required in production. HMAC secret used to sign session tokens (see auth.js).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the app falls back to an ephemeral random secret for local development only
# (all sessions are invalidated on every restart) — it will refuse to start in production.
SESSION_SECRET=

# Telegram bot token used for OTP delivery and emergency alerts (see telegram.js).
# If unset, the app runs in "dev mode" and logs OTP codes to the console instead of
# sending them via Telegram — fine for local development, never for production.
TELEGRAM_BOT_TOKEN=

# Port the Express server listens on. Defaults to 8000 if unset.
PORT=8000

# Set to "production" to enforce production-only checks (e.g. requiring SESSION_SECRET).
NODE_ENV=development

# Set to "true" only if the app runs behind a trusted reverse proxy / load balancer that
# sets X-Forwarded-For correctly. Enables `app.set('trust proxy', 1)` so rate limiting and
# audit logs see the real client IP. Leave unset/false on a directly-exposed server, since
# trusting X-Forwarded-For from untrusted clients allows rate-limit bypass.
TRUST_PROXY=false

# ==========================================
# FIREBASE MIGRATION CONFIGURATION
# ==========================================
# Absolute path to your Firebase service account JSON key file.
# E.g., /path/to/lifelink-demo-firebase-adminsdk.json
FIREBASE_CREDENTIALS_PATH=

# Local Emulators (Set these to use local emulator instead of real Firebase)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# The URL of the Python AI Microservice (used for NLP parsing and Chatbot).
# Defaults to http://localhost:8001
PYTHON_API_URL=http://localhost:8001
